{
  "name": "songling715-blog",
  "version": "1.0.0",
  "private": true,
  "description": "songling715 的个人技术博客",
  "scripts": {
    "build": "hexo generate",
    "clean": "hexo clean",
    "server": "hexo server",
    "new": "hexo new",
    "deploy": "hexo generate && wrangler pages deploy public --project-name=songling715 --branch=main --commit-dirty=true && node tools/indexnow.js && node tools/baidu-push.js",
    "check": "node tools/visual-check.js",
    "ping": "node tools/indexnow.js",
    "push:baidu": "node tools/baidu-push.js"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "hexo": "^7.3.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^4.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-search": "^2.4.3",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^6.3.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0"
  },
  "devDependencies": {
    "puppeteer-core": "^24.0.0",
    "wrangler": "^4.0.0"
  }
}